---
// src/pages/transaksi/[id].astro
import Layout from "../../layouts/Layout.astro";
import { api } from "../../lib/api";

const { id } = Astro.params;
let transaksi = null;
let rincianBarang = [];

const token = Astro.cookies.get("directus_token")?.value;
const config = { headers: { Authorization: `Bearer ${token}` } };

try {
    // API dengan relasi yang sudah diperbaiki (melewati tabel jembatan M2M)
    const resTrx = await api.get(
        `/items/transaksi/${id}?fields=*,detail_transaksi.*,detail_transaksi.produk_id.nama_produk,detail_transaksi.mekanik_id.mekanik_id.nama_mekanik`, config
    );
    transaksi = resTrx.data.data;
    rincianBarang = transaksi?.detail_transaksi || [];
} catch (error) {
    console.error(`Gagal mengambil detail transaksi ID ${id}:`, error.message);
}

if (!transaksi) {
    return Astro.redirect("/transaksi");
}

function formatTanggal(isoString) {
    if (!isoString) return "-";
    const date = new Date(isoString);
    return new Intl.DateTimeFormat("id-ID", {
        day: "2-digit",
        month: "long",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
    }).format(date);
}
---

<Layout title={`Detail Transaksi #${id}`}>
    <div class="max-w-5xl mx-auto px-4 py-8">
        <div class="mb-6">
            <a
                href="/transaksi"
                class="text-slate-500 hover:text-slate-800 font-medium inline-flex items-center gap-2 transition text-sm"
            >
                <i class="fa-solid fa-arrow-left"></i> Kembali ke Riwayat
            </a>
        </div>

        <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="bg-slate-900 text-white p-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <span class="bg-indigo-500/20 text-indigo-300 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                        Laporan Internal
                    </span>
                    <h2 class="text-2xl font-black mt-1">
                        Transaksi #{transaksi.id}
                    </h2>
                </div>
                <div class="sm:text-right">
                    <p class="text-slate-400 text-xs uppercase tracking-wider">
                        Waktu Transaksi
                    </p>
                    <p class="font-bold">
                        {formatTanggal(transaksi.tanggal_transaksi)}
                    </p>
                </div>
            </div>

            <div class="p-6 overflow-x-auto">
                <table class="w-full text-left border-collapse min-w-[800px]">
                    <thead>
                        <tr class="border-b border-slate-200 text-slate-400 text-xs font-bold uppercase tracking-wider">
                            <th class="pb-3 w-4/12">Item / Pekerjaan</th>
                            <th class="pb-3 text-center w-1/12">Qty</th>
                            <th class="pb-3 text-right w-3/12">Tagihan Konsumen</th>
                            <th class="pb-3 text-right w-4/12 pl-6 border-l border-slate-100">Rincian Profit / Komisi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        {
                            rincianBarang.map((item) => {
                                // Kalkulasi Dasar
                                const qty = item.qty || 1;
                                const hargaJualSatuan = item.harga_jual_snapshot || 0;
                                const hargaModalSatuan = item.harga_modal_snapshot || 0;

                                const subtotalJual = qty * hargaJualSatuan;
                                const totalModal = qty * hargaModalSatuan;

                                const isJasa = item.tipe_item === "jasa";

                                // Kalkulasi Keuntungan
                                let labaSatuan = hargaJualSatuan - hargaModalSatuan;
                                let totalLabaItem = 0;

                                if (isJasa) {
                                    totalLabaItem = subtotalJual - (item.total_komisi_jasa || 0);
                                } else {
                                    totalLabaItem = subtotalJual - totalModal;
                                }

                                return (
                                    <tr class="hover:bg-slate-50/50 transition group">
                                        {/* KOLOM 1: Nama Item & Label */}
                                        <td class="py-4 align-top">
                                            <p class="font-bold text-slate-800">
                                                {item.produk_id?.nama_produk || item.nama_item}
                                            </p>
                                            <div class="flex items-center gap-2 mt-1">
                                                <span class={`text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider ${isJasa ? "bg-amber-100 text-amber-700" : "bg-blue-100 text-blue-700"}`}>
                                                    {item.tipe_item}
                                                </span>
                                                {/* PERBAIKAN: Mapping Array Mekanik untuk M2M */}
                                                {isJasa && item.mekanik_id && item.mekanik_id.length > 0 && (
                                                    <span class="text-xs font-medium text-slate-500">
                                                        <i class="fa-solid fa-wrench mr-1" /> 
                                                        {item.mekanik_id.map((m: any) => m.mekanik_id?.nama_mekanik).join(", ")}
                                                    </span>
                                                )}
                                            </div>
                                            
                                            {/* TAMBAHAN KETERANGAN DISINI */}
                                            {item.keterangan && (
                                                <div class="mt-2 pt-2 border-t border-slate-100 text-[11px] text-slate-500 whitespace-pre-wrap leading-relaxed inline-block">
                                                    <i class="fa-solid fa-note-sticky mr-1"></i> {item.keterangan}
                                                </div>
                                            )}
                                        </td>

                                        {/* KOLOM 2: Kuantitas */}
                                        <td class="py-4 text-center align-top font-medium text-slate-600">
                                            {qty}
                                        </td>

                                        {/* KOLOM 3: Tagihan ke Konsumen (Omzet) */}
                                        <td class="py-4 text-right align-top">
                                            <p class="font-bold text-slate-800">
                                                Rp {subtotalJual.toLocaleString("id-ID")}
                                            </p>
                                            <p class="text-xs text-slate-400 mt-0.5">
                                                @ Rp {hargaJualSatuan.toLocaleString("id-ID")}
                                            </p>
                                        </td>

                                        {/* KOLOM 4: Bedah Rahasia Profit Internal */}
                                        <td class="py-4 pl-6 border-l border-slate-100 text-right align-top">
                                            {isJasa ? (
                                                <div class="space-y-1.5 text-xs">
                                                    <div class="flex justify-between items-center text-slate-500">
                                                        <span>Total Tarif Jasa:</span>
                                                        <span>Rp {subtotalJual.toLocaleString("id-ID")}</span>
                                                    </div>
                                                    <div class="flex justify-between items-center text-slate-600 border-b border-slate-100 pb-1.5">
                                                        <span>
                                                            Gaji Mekanik ({item.persentase_komisi || 0}%):
                                                        </span>
                                                        <span class="font-bold text-amber-600">
                                                            - Rp {(item.total_komisi_jasa || 0).toLocaleString("id-ID")}
                                                        </span>
                                                    </div>
                                                    <div class="flex justify-between items-center bg-slate-50 p-1.5 rounded">
                                                        <span class="font-bold text-slate-700">
                                                            Laba Bersih Bengkel:
                                                        </span>
                                                        <span class="font-bold text-emerald-600">
                                                            Rp {totalLabaItem.toLocaleString("id-ID")}
                                                        </span>
                                                    </div>
                                                </div>
                                            ) : (
                                                <div class="space-y-1 text-xs">
                                                    <div class="flex justify-between items-center text-slate-500">
                                                        <span>Modal Satuan:</span>
                                                        <span>Rp {hargaModalSatuan.toLocaleString("id-ID")}</span>
                                                    </div>
                                                    <div class="flex justify-between items-center text-slate-500">
                                                        <span>Total Modal ({qty}x):</span>
                                                        <span>Rp {totalModal.toLocaleString("id-ID")}</span>
                                                    </div>
                                                    <div class="flex justify-between items-center text-slate-500 mt-1 pt-1 border-t border-slate-100">
                                                        <span>Laba per Satuan:</span>
                                                        <span>Rp {labaSatuan.toLocaleString("id-ID")}</span>
                                                    </div>
                                                    <div class="flex justify-between items-center bg-slate-50 p-1.5 rounded mt-1.5">
                                                        <span class="font-bold text-slate-700">
                                                            Total Laba Bersih:
                                                        </span>
                                                        <span class={`font-bold ${totalLabaItem < 0 ? "text-red-600" : "text-emerald-600"}`}>
                                                            Rp {totalLabaItem.toLocaleString("id-ID")}
                                                        </span>
                                                    </div>
                                                </div>
                                            )}
                                        </td>
                                    </tr>
                                );
                            })
                        }
                    </tbody>
                </table>

                <div class="mt-8 border-t border-slate-200 pt-6 flex flex-col items-end gap-3">
                    <div class="flex justify-between items-center w-full sm:w-96 text-sm px-2">
                        <span class="text-slate-500 font-medium">Pendapatan Kotor (Total Tagihan):</span>
                        <span class="font-black text-slate-800 text-xl">
                            Rp {transaksi.total_harga ? transaksi.total_harga.toLocaleString("id-ID") : "0"}
                        </span>
                    </div>

                    <div class={`flex justify-between items-center w-full sm:w-96 text-sm px-4 py-3 rounded-xl font-medium border ${transaksi.total_profit < 0 ? "bg-red-50 text-red-700 border-red-200" : "bg-emerald-50 text-emerald-800 border-emerald-200"}`}>
                        <span class="font-bold uppercase tracking-wider text-xs">
                            {transaksi.total_profit < 0 ? "Rugi Bersih:" : "Pendapatan Bersih (Laba):"}
                        </span>
                        <span class="font-black text-lg">
                            Rp {transaksi.total_profit ? transaksi.total_profit.toLocaleString("id-ID") : "0"}
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>