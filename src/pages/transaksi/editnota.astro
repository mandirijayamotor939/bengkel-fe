---
import Layout from "../../layouts/Layout.astro";
import { api } from "../../lib/api";

const url = new URL(Astro.request.url);
const trxId = url.searchParams.get("id");

if (!trxId) {
    return Astro.redirect("/gantung");
}

// ==========================================
// 1. AMBIL TOKEN DAN BUAT CONFIG HEADER
// ==========================================
const token = Astro.cookies.get("directus_token")?.value;
const config = { headers: { Authorization: `Bearer ${token}` } };
// ==========================================

// Helper Hitung Profit (Dibutuhkan saat mau menghapus item agar profit header ikut berkurang)
const getProfit = (d) => {
    if (d.tipe_item === "sparepart" || d.tipe_item === "ulakan") {
        return (d.harga_jual_snapshot - d.harga_modal_snapshot) * d.qty;
    } else if (d.tipe_item === "jasa") {
        return (d.harga_jual_snapshot * d.qty) - (d.total_komisi_jasa || 0);
    }
    return 0;
};

// 1. HANDLE HAPUS ITEM (SERVER-SIDE)
if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        const detailId = formData.get("detail_id");
        const tipeItem = formData.get("tipe_item");
        const subtotalToDeduct = Number(formData.get("subtotal_deduct") || 0);
        const profitToDeduct = Number(formData.get("profit_deduct") || 0);

        // TAHAP 1: SAPU BERSIH KOMISI MEKANIK (Jika ada)
        try {
            const resMekanik = await api.get(`/items/detail_transaksi_mekanik?filter[detail_transaksi_id][_eq]=${detailId}`, config);
            const mekanikIds = resMekanik.data.data.map(m => m.id);
            if (mekanikIds.length > 0) {
                await api.delete('/items/detail_transaksi_mekanik', { data: mekanikIds, ...config });
                console.log("Berhasil menghapus relasi mekanik:", mekanikIds);
            }
        } catch (err) {
            console.log("Cek mekanik error/kosong:", err.message);
        }

        // TAHAP 2: SAPU BERSIH PENGELUARAN (Untuk Ulakan & Jasa)
        try {
            const resPengeluaran = await api.get(`/items/pengeluaran?filter[detail_transaksi_id][_eq]=${detailId}`, config);
            const pengeluaranIds = resPengeluaran.data.data.map(p => p.id);
            if (pengeluaranIds.length > 0) {
                await api.delete('/items/pengeluaran', { data: pengeluaranIds, ...config });
                console.log("Berhasil menghapus relasi pengeluaran:", pengeluaranIds);
            }
        } catch (err) {
            console.log("Cek pengeluaran error/kosong:", err.message);
        }

        // TAHAP 3: HAPUS ITEM UTAMA (Sekarang sudah bebas hambatan!)
        await api.delete(`/items/detail_transaksi/${detailId}`, config);
        console.log(`Berhasil menghapus item detail_transaksi: ${detailId}`);

        // TAHAP 4: UPDATE TOTAL HARGA & PROFIT DI HEADER TRANSAKSI
        const getTrx = await api.get(`/items/transaksi/${trxId}`, config);
        const currentTrx = getTrx.data.data;
        
        await api.patch(`/items/transaksi/${trxId}`, {
            total_harga: Math.max(0, currentTrx.total_harga - subtotalToDeduct),
            total_profit: currentTrx.total_profit - profitToDeduct
        }, config);

        return Astro.redirect(`/transaksi/editnota?id=${trxId}`);
    } catch (error) {
        console.log("=== MASIH GAGAL HAPUS ===");
        console.log(error.response?.data?.errors || error.message);
    }
}

// 2. AMBIL DATA TRANSAKSI, PRODUK, & MEKANIK
let trx = null;
let daftarProduk = [];
let daftarMekanik = [];

try {
    const [resTrx, resProduk, resMekanik] = await Promise.all([
        api.get(`/items/transaksi/${trxId}?fields=*,detail_transaksi.*,detail_transaksi.produk_id.*`, config),
        api.get("/items/produk?filter[stok_qty][_gt]=0", config),
        api.get("/items/mekanik", config)
    ]);
    trx = resTrx.data.data;
    daftarProduk = resProduk.data.data;
    daftarMekanik = resMekanik.data.data;
} catch (error) {
    console.error("Gagal mengambil data:", error);
    return Astro.redirect("/gantung");
}

const formatRp = (angka) => {
    return new Intl.NumberFormat("id-ID", {
        style: "currency", currency: "IDR", maximumFractionDigits: 0,
    }).format(Number(angka));
};
---

<Layout title={`Edit Nota #${trxId}`}>
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-black text-slate-800 tracking-tight">Edit Nota #{trxId}</h2>
            <p class="text-slate-500 text-sm mt-1">
                Ubah atau tambah item untuk nota yang berstatus proses.
            </p>
        </div>
        <a href="/gantung" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-4 py-2.5 rounded-xl font-bold transition flex items-center gap-2 shadow-sm text-sm">
            <i class="fa-solid fa-arrow-left"></i> Kembali ke Gantung
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        
        
        <!-- KOLOM KIRI: FORM TAMBAH ITEM (1/3 Lebar) -->

        <div class="lg:col-span-1 bg-white p-6 rounded-2xl shadow-sm border border-slate-100 space-y-5">
            <h3 class="text-base font-bold text-slate-800 border-b border-slate-100 pb-3 flex items-center gap-2">
                <i class="fa-solid fa-cart-plus text-indigo-600"></i> Tambah Item Susulan
            </h3>

            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Tipe Item</label>
                <select id="tipe_item_select" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium">
                    <option value="sparepart">⚙️ Sparepart (Potong Stok)</option>
                    <option value="jasa">🛠️ Jasa Servis / Perbaikan</option>
                    <option value="ulakan">📦 Ulakan (Beli di Luar Toko)</option>
                </select>
            </div>

            <!-- FORM SPAREPART -->
            <div id="form_sparepart" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Pilih Produk</label>
                    <input type="text" id="search_sparepart" placeholder="🔍 Cari nama sparepart..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 mb-3" />
                    <select id="sparepart_select" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="">-- Pilih Barang --</option>
                        {daftarProduk.map((p: any) => (
                            <option value={p.id} data-nama={p.nama_produk} data-modal={p.harga_modal} data-jual={p.harga_jual} data-stok={p.stok_qty}>
                                {p.nama_produk} (Stok: {p.stok_qty})
                            </option>
                        ))}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Quantity (Qty)</label>
                    <input type="number" id="sparepart_qty" value="1" min="1" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 font-bold" />
                </div>
            </div>

            <!-- FORM JASA -->
            <div id="form_jasa" class="space-y-4 hidden">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Nama Jasa</label>
                    <input type="text" id="jasa_title" placeholder="Contoh: Bongkar Mesin" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Biaya Jasa</label>
                        <input type="number" id="jasa_fee" placeholder="0" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 font-bold" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Komisi (%)</label>
                        <input type="number" id="jasa_persen" value="60" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 font-bold" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Pilih Mekanik</label>
                    <select id="mekanik_select" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" multiple>
                        {daftarMekanik.map((m: any) => (
                            <option value={m.id}>{m.nama_mekanik}</option>
                        ))}
                    </select>
                </div>
            </div>

            <!-- FORM ULAKAN -->
            <div id="form_ulakan" class="space-y-4 hidden">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Nama Barang Ulakan</label>
                    <input type="text" id="ulakan_title" placeholder="Contoh: Kampas Kopling Luar" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Modal (Beli)</label>
                        <input type="number" id="ulakan_modal" placeholder="0" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 font-bold" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Jual ke User</label>
                        <input type="number" id="ulakan_jual" placeholder="0" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 font-bold" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Quantity (Qty)</label>
                    <input type="number" id="ulakan_qty" value="1" min="1" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 font-bold" />
                </div>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-100">
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
                    Catatan / Keterangan (Opsional)
                </label>
                <textarea id="keterangan_item" rows="2" placeholder="Contoh: Bawaan pelanggan, garansi 1 minggu..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
            </div>

<button id="btn_tambah_susulan" class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-black text-sm rounded-xl shadow-lg hover:shadow-indigo-500/30 transition-all flex items-center justify-center gap-2 mt-6 uppercase tracking-wide">
    <i class="fa-solid fa-plus"></i> Tambah Item Langsung
</button>
        </div>

        <!-- KOLOM KANAN: ISI NOTA SAAT INI (2/3 Lebar) -->
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden flex flex-col justify-between">
            <div class="p-6 border-b border-slate-100">
                <h3 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-receipt text-slate-700"></i> Daftar Item Saat Ini
                </h3>
            </div>

            <div class="overflow-x-auto min-h-[250px] p-4">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 text-slate-400 text-[11px] font-bold uppercase tracking-wider">
                            <th class="p-3">Nama Item</th>
                            <th class="p-3 text-center">Tipe</th>
                            <th class="p-3 text-center">Qty</th>
                            <th class="p-3 text-right">Subtotal</th>
                            <th class="p-3 text-center">Hapus</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm">
                        {trx.detail_transaksi && trx.detail_transaksi.length > 0 ? (
                            trx.detail_transaksi.map((detail) => (
                                <tr class="border-b border-slate-100 hover:bg-slate-50/50">
                                    <td class="p-3 font-semibold text-slate-700">
                                        {detail.nama_item || detail.produk_id?.nama_produk}
                                        {detail.keterangan && (
                                            <div class="text-[11px] font-normal text-slate-400 mt-1 whitespace-pre-wrap leading-relaxed">
                                                <i class="fa-solid fa-note-sticky mr-1"></i> {detail.keterangan}
                                            </div>
                                        )}
                                    </td>
                                    <td class="p-3 text-center">
                                        <span class="bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md text-[10px] font-black uppercase tracking-wider">
                                            {detail.tipe_item}
                                        </span>
                                    </td>
                                    <td class="p-3 text-center font-bold">{detail.qty}</td>
                                    <td class="p-3 text-right font-bold text-slate-800">
                                        {formatRp(detail.harga_jual_snapshot * detail.qty)}
                                    </td>
                                    <td class="p-3 text-center">
                                        <!-- Form Delete per Item -->
                                        <form method="POST" onsubmit="return confirm('Yakin hapus item ini?');">
                                            <input type="hidden" name="detail_id" value={detail.id} />
                                            <input type="hidden" name="tipe_item" value={detail.tipe_item} />
                                            <input type="hidden" name="subtotal_deduct" value={detail.harga_jual_snapshot * detail.qty} />
                                            <input type="hidden" name="profit_deduct" value={getProfit(detail)} />
                                            <button type="submit" class="text-red-500 hover:text-red-700 bg-red-50 hover:bg-red-100 p-1.5 rounded-lg transition">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            ))
                        ) : (
                            <tr>
                                <td colspan="5" class="p-8 text-center text-slate-400 font-medium">Belum ada item di nota ini.</td>
                            </tr>
                        )}
                    </tbody>
                </table>
            </div>

            <!-- GRAND TOTAL -->
            <div class="bg-slate-50 p-6 border-t border-slate-100">
                <div class="flex justify-between items-center bg-white border border-slate-200 p-4 rounded-xl shadow-sm">
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Nota Saat Ini</span>
                        <h4 class="text-3xl font-black text-slate-800 tracking-tight mt-0.5">
                            {formatRp(trx.total_harga || 0)}
                        </h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    // Toggle Form Input
    const tipeItemSelect = document.getElementById("tipe_item_select");
    const formSparepart = document.getElementById("form_sparepart");
    const formJasa = document.getElementById("form_jasa");
    const formUlakan = document.getElementById("form_ulakan");

    const searchSparepart = document.getElementById("search_sparepart");
    const sparepartSelect = document.getElementById("sparepart_select");

    if (searchSparepart && sparepartSelect) {
        searchSparepart.addEventListener("input", function(e) {
            const keyword = e.target.value.toLowerCase();
            const options = sparepartSelect.querySelectorAll("option");

            options.forEach(option => {
                // Lewati opsi default kosong
                if (option.value === "") return; 

                const namaProduk = option.text.toLowerCase();
                if (namaProduk.includes(keyword)) {
                    option.style.display = ""; // Tampilkan
                } else {
                    option.style.display = "none"; // Sembunyikan
                }
            });
        });
    }

    if (tipeItemSelect) {
        tipeItemSelect.addEventListener("change", () => {
            const val = tipeItemSelect.value;
            if (formSparepart) formSparepart.classList.toggle("hidden", val !== "sparepart");
            if (formJasa) formJasa.classList.toggle("hidden", val !== "jasa");
            if (formUlakan) formUlakan.classList.toggle("hidden", val !== "ulakan");
        });
    }

    // Handle Submit Tambah
    const btnTambah = document.getElementById("btn_tambah_susulan");
    if (btnTambah) {
        btnTambah.addEventListener("click", async () => {
            const urlParams = new URLSearchParams(window.location.search);
            const trxId = urlParams.get('id');
            
            const tipe = tipeItemSelect ? tipeItemSelect.value : "";
            const keteranganInput = document.getElementById("keterangan_item");
            const keteranganText = keteranganInput ? keteranganInput.value.trim() : "";

            let payloadItem = null;
            let subtotal = 0;
            let profit = 0;

            // 1. SIAPKAN DATA BERDASARKAN TIPE
            if (tipe === "sparepart") {
                const el = document.getElementById("sparepart_select");
                if (!el.value) return alert("Pilih sparepart!");
                
                const opt = el.options[el.selectedIndex];
                const qtyInput = document.getElementById("sparepart_qty");
                const qty = parseInt(qtyInput ? qtyInput.value : "1") || 1;
                
                if (qty > parseInt(opt.dataset.stok)) return alert("Stok tidak cukup!");

                payloadItem = {
                    transaksi_id: trxId,
                    tipe_item: "sparepart",
                    produk_id: el.value,
                    nama_item: opt.dataset.nama,
                    qty: qty,
                    harga_modal_snapshot: parseInt(opt.dataset.modal),
                    harga_jual_snapshot: parseInt(opt.dataset.jual),
                    keterangan: keteranganText
                };
                subtotal = payloadItem.harga_jual_snapshot * qty;
                profit = (payloadItem.harga_jual_snapshot - payloadItem.harga_modal_snapshot) * qty;

            } else if (tipe === "jasa") {
                const titleInput = document.getElementById("jasa_title");
                const feeInput = document.getElementById("jasa_fee");
                const persenInput = document.getElementById("jasa_persen");
                
                const title = titleInput ? titleInput.value.trim() : "";
                const fee = parseInt(feeInput ? feeInput.value : "0") || 0;
                const komisiPersen = parseInt(persenInput ? persenInput.value : "0") || 0;
                
                const mekanikEl = document.getElementById("mekanik_select");
                const selectedMekanik = mekanikEl ? Array.from(mekanikEl.selectedOptions).map(opt => opt.value) : [];

                if (!title || fee <= 0 || selectedMekanik.length === 0) return alert("Lengkapi data Jasa dan pilih Mekanik!");

                const totalKomisi = Math.round(fee * (komisiPersen / 100));

                payloadItem = {
                    transaksi_id: trxId,
                    tipe_item: "jasa",
                    nama_item: title,
                    qty: 1,
                    harga_modal_snapshot: 0,
                    harga_jual_snapshot: fee,
                    persentase_komisi: komisiPersen,
                    total_komisi_jasa: totalKomisi,
                    mekanik_ids_temp: selectedMekanik,
                    keterangan: keteranganText
                };
                
                subtotal = fee;
                profit = fee - totalKomisi;

            } else if (tipe === "ulakan") {
                const titleInput = document.getElementById("ulakan_title");
                const modalInput = document.getElementById("ulakan_modal");
                const jualInput = document.getElementById("ulakan_jual");
                const qtyInput = document.getElementById("ulakan_qty");

                const title = titleInput ? titleInput.value.trim() : "";
                const modal = parseInt(modalInput ? modalInput.value : "0") || 0;
                const jual = parseInt(jualInput ? jualInput.value : "0") || 0;
                const qty = parseInt(qtyInput ? qtyInput.value : "1") || 1;

                if (!title || modal <= 0 || jual <= 0) return alert("Data ulakan tidak valid!");

                payloadItem = {
                    transaksi_id: trxId,
                    tipe_item: "ulakan",
                    nama_item: title,
                    qty: qty,
                    harga_modal_snapshot: modal,
                    harga_jual_snapshot: jual,
                    keterangan: keteranganText
                };
                
                subtotal = jual * qty;
                profit = (jual - modal) * qty;
            }

            // 2. KIRIM KE ENDPOINT ASTRO
            const originalText = btnTambah.innerHTML;
            btnTambah.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...`;
            btnTambah.disabled = true;

            try {
                const response = await fetch('/api/tambah-susulan', {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ trxId, tipe, payloadItem, subtotal, profit })
                });

                const result = await response.json();

                if (result.success) {
                    window.location.reload(); 
                } else {
                    alert("Gagal: " + (result.message || "Terjadi kesalahan server."));
                }
            } catch (error) {
                alert("Terjadi kesalahan jaringan.");
                console.error(error);
            } finally {
                btnTambah.innerHTML = originalText;
                btnTambah.disabled = false;
            }
        });
    }
</script>