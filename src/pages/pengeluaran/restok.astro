---
// src/pages/pengeluaran/restok.astro
import Layout from "../../layouts/Layout.astro";
import { getWithAuth } from "../../lib/api";

const token = Astro.cookies.get("directus_token")?.value || "";
let listProduk = [];
let isError = false;

try {
    const resProduk = await getWithAuth("/items/produk?sort=nama_produk", token);
    listProduk = resProduk.data.data || [];
} catch (error) {
    console.error("Gagal menarik data produk:", error.message);
    isError = true;
}

const hariIni = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Asia/Jakarta",
    year: "numeric",
    month: "2-digit",
    day: "2-digit"
}).format(new Date());
---

<Layout title="Form Restok Barang Grosir">
    <div class="max-w-6xl mx-auto px-4 py-8">
        
        <div class="mb-6">
            <a href="/produk" class="text-slate-500 hover:text-slate-800 font-medium inline-flex items-center gap-2 text-sm transition">
                <i class="fa-solid fa-arrow-left"></i> Kembali ke Katalog Produk
            </a>
        </div>

        <div class="mb-8">
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Restok Barang Grosir</h1>
            <p class="text-slate-500 mt-1">Catat nota belanja grosir dari supplier. Otomatis menaikkan stok fisik dan memperbarui harga di etalase.</p>
        </div>

        {isError && (
            <div class="bg-red-50 text-red-700 p-4 rounded-xl mb-6">
                Terjadi kesalahan saat memuat data produk dari database.
            </div>
        )}

        <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
            <form id="formRestok" class="p-8">
                
                {/* Bagian Induk Nota & Sumber Dana */}
                <div class="mb-8 pb-8 border-b border-slate-100 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Tanggal Pembelian <span class="text-red-500">*</span></label>
                        <input 
                            type="date" 
                            id="tanggalPembelian" 
                            value={hariIni}
                            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none bg-slate-50 focus:bg-white transition"
                            required
                        />
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Sumber Dana Pembayaran <span class="text-red-500">*</span></label>
                        <select id="sumberDana" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none bg-slate-50 focus:bg-white transition font-semibold text-slate-800" required>
                            <option value="transfer_bank" selected>Transfer Bank (M-Banking / Uang Luar Laci)</option>
                            <option value="laci_kasir">Laci Kasir (Uang Cash Bengkel)</option>
                        </select>
                        <p class="text-xs text-slate-400 mt-1">Pilih 'Laci Kasir' hanya jika uang dibayarkan langsung dari kas tunai toko.</p>
                    </div>
                </div>

                {/* Bagian Detail Barang */}
                <div class="mb-4 flex justify-between items-center">
                    <h2 class="text-lg font-black text-slate-800">Daftar Barang Masuk</h2>
                    
                    <div class="flex gap-3">
                        <a href="/produk/baru" class="bg-slate-100 text-slate-700 hover:bg-slate-200 px-4 py-2 rounded-xl text-sm font-bold transition flex items-center gap-2">
                            <i class="fa-solid fa-box-open"></i> Buat Produk Baru
                        </a>
                        <button type="button" onclick="window.tambahBaris()" class="bg-indigo-50 text-indigo-700 hover:bg-indigo-100 px-4 py-2 rounded-xl text-sm font-bold transition flex items-center gap-2">
                            <i class="fa-solid fa-plus"></i> Tambah Baris
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto mb-8">
                    <table class="w-full text-left text-sm" id="tabelRestok">
                        <thead class="bg-slate-50 text-xs uppercase font-black text-slate-500 border-y border-slate-200">
                            <tr>
                                <th class="px-3 py-3 w-1/3">Nama Produk</th>
                                <th class="px-3 py-3 w-20 text-center">Qty</th>
                                <th class="px-3 py-3">Harga Modal Baru</th>
                                <th class="px-3 py-3">Harga Jual Baru</th>
                                <th class="px-3 py-3 text-right">Subtotal Modal</th>
                                <th class="px-3 py-3 text-center">Hapus</th>
                            </tr>
                        </thead>
                        <tbody id="wadahBaris" class="divide-y divide-slate-100">
                            {/* Di-generate via Javascript */}
                        </tbody>
                        <tfoot class="bg-slate-50 border-y border-slate-200">
                            <tr>
                                <td colspan="4" class="px-4 py-4 text-right font-black uppercase text-slate-600">Total Modal Restok:</td>
                                <td colspan="2" class="px-4 py-4 text-right font-black text-2xl text-indigo-600" id="tampilanTotal">Rp 0</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="flex justify-end pt-4">
                    <button type="submit" id="btnSimpan" class="bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-4 rounded-xl font-black shadow-lg transition flex items-center gap-3 text-lg">
                        <i class="fa-solid fa-check-circle"></i> Simpan Restok Grosir
                    </button>
                </div>

            </form>
        </div>
    </div>
</Layout>

<script is:inline define:vars={{ listProduk }}>
    function formatRupiah(angka) {
        return new Intl.NumberFormat('id-ID').format(angka);
    }

    // --- DI-TEMPEL KE WINDOW AGAR BISA DIPANGGIL OLEH HTML ONCLICK ---
    window.hitungTotal = function() {
        let totalRestok = 0;
        const baris = document.querySelectorAll('.baris-item');
        
        baris.forEach(row => {
            const qty = parseFloat(row.querySelector('.input-qty').value) || 0;
            const hargaModal = parseFloat(row.querySelector('.input-modal').value) || 0;
            
            const subtotal = qty * hargaModal;
            
            row.querySelector('.teks-subtotal').innerText = 'Rp ' + formatRupiah(subtotal);
            totalRestok += subtotal;
        });

        document.getElementById('tampilanTotal').innerText = `Rp ${formatRupiah(totalRestok)}`;
    };

    window.setHargaDefault = function(selectElement) {
        const selectedOption = selectElement.options[selectElement.selectedIndex];
        const hargaModalLama = selectedOption.getAttribute('data-modal') || 0;
        const hargaJualLama = selectedOption.getAttribute('data-jual') || 0;
        
        const row = selectElement.closest('tr');
        const inputModal = row.querySelector('.input-modal');
        const inputJual = row.querySelector('.input-jual');
        
        // Langsung isi nilainya secara otomatis
        inputModal.value = hargaModalLama;
        inputJual.value = hargaJualLama;
        
        // Panggil perhitungan otomatis
        window.hitungTotal();
    };

    window.tambahBaris = function() {
        const tbody = document.getElementById('wadahBaris');
        
        const opsiProduk = listProduk.map(p => 
            `<option value="${p.id}" data-modal="${p.harga_modal}" data-jual="${p.harga_jual}">${p.nama_produk}</option>`
        ).join('');

        const tr = document.createElement('tr');
        tr.className = 'baris-item hover:bg-slate-50 transition';
        tr.innerHTML = `
            <td class="px-3 py-3">
                <select class="input-produk w-full px-3 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none text-sm bg-white" required onchange="window.setHargaDefault(this)">
                    <option value="" disabled selected>-- Pilih Produk --</option>
                    ${opsiProduk}
                </select>
            </td>
            <td class="px-3 py-3">
                <input type="number" min="1" value="1" class="input-qty w-full px-2 py-2 rounded-lg border border-slate-300 text-center focus:ring-2 focus:ring-indigo-500 outline-none text-sm" placeholder="1" required oninput="window.hitungTotal()">
            </td>
            <td class="px-3 py-3">
                <input type="number" min="0" class="input-modal w-full px-3 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none text-sm" placeholder="Modal" required oninput="window.hitungTotal()">
            </td>
            <td class="px-3 py-3">
                <input type="number" min="0" class="input-jual w-full px-3 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none text-sm" placeholder="Jual" required>
            </td>
            <td class="px-3 py-3 text-right font-bold text-slate-700 teks-subtotal">
                Rp 0
            </td>
            <td class="px-3 py-3 text-center">
                <button type="button" onclick="window.hapusBaris(this)" class="text-red-400 hover:text-red-600 transition p-2">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            </td>
        `;
        tbody.appendChild(tr);
    };

    window.hapusBaris = function(btn) {
        btn.closest('tr').remove();
        window.hitungTotal();
    };

    // Jalankan sekali saat halaman dimuat
    document.addEventListener('DOMContentLoaded', () => {
        window.tambahBaris();
    });

    // Proses Submit Form ke Backend API
    document.getElementById('formRestok').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const tanggalPembelian = document.getElementById('tanggalPembelian').value;
        const sumberDana = document.getElementById('sumberDana').value;
        const barisItem = document.querySelectorAll('.baris-item');
        const items = [];

        barisItem.forEach(row => {
            const produkId = row.querySelector('.input-produk').value;
            const qty = parseInt(row.querySelector('.input-qty').value) || 0;
            const hargaModal = parseInt(row.querySelector('.input-modal').value) || 0;
            const hargaJual = parseInt(row.querySelector('.input-jual').value) || 0;
            
            if (produkId && qty > 0) {
                items.push({
                    produk_id: produkId,
                    qty_masuk: qty,
                    harga_modal_baru: hargaModal,
                    harga_jual_baru: hargaJual
                });
            }
        });

        if (items.length === 0) {
            alert("Harap pilih minimal 1 barang.");
            return;
        }

        const btn = document.getElementById('btnSimpan');
        const originalText = btn.innerHTML;
        btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Memproses Restok...`;
        btn.disabled = true;

        try {
            const response = await fetch('/api/tambah-restok', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    tanggal_pembelian: tanggalPembelian,
                    sumber_dana: sumberDana,
                    items: items
                })
            });

            const result = await response.json();

            if (result.success) {
                alert("Sukses! " + result.message);
                window.location.href = "/produk";
            } else {
                alert("Gagal: " + (result.message || "Terjadi kesalahan server."));
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        } catch (error) {
            alert("Terjadi kesalahan jaringan/server.");
            console.error(error);
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    });
</script>