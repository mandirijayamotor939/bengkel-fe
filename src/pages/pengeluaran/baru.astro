---
// src/pages/pengeluaran/baru.astro
import Layout from "../../layouts/Layout.astro";

// MENGATASI BUG ZONA WAKTU (Memaksa ke WIB / Asia/Jakarta)
const formatter = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Asia/Jakarta",
    year: "numeric",
    month: "2-digit",
    day: "2-digit"
});
// Hasilnya akan selalu "YYYY-MM-DD" sesuai waktu WIB saat ini
const hariIni = formatter.format(new Date());
---

<Layout title="Operasional & Pengaturan Bengkel">
    <div class="max-w-6xl mx-auto px-4 py-8">
        
        <div class="mb-6">
            <a href="/pengeluaran" class="text-slate-500 hover:text-slate-800 font-medium inline-flex items-center gap-2 text-sm transition">
                <i class="fa-solid fa-arrow-left"></i> Batal & Kembali
            </a>
        </div>

        <div class="mb-8">
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">Operasional & Pengaturan</h1>
            <p class="text-slate-500 mt-1">Catat biaya operasional eksternal dadakan atau sesuaikan pengaturan biaya tetap bengkel.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            
            <!-- KARTU 1: PENGELUARAN OPERASIONAL -->
            <div class="bg-white rounded-3xl shadow-sm border border-slate-200 p-8 h-fit">
                <div class="mb-6 border-b border-slate-100 pb-4">
                    <h2 class="text-xl font-bold text-slate-800"><i class="fa-solid fa-receipt text-indigo-500 mr-2"></i> Catat Operasional Eksternal</h2>
                    <p class="text-sm text-slate-500 mt-1">Contoh: Beli air galon, token listrik, fotokopi nota, dll.</p>
                </div>

                <form id="formOperasional" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Tanggal <span class="text-red-500">*</span></label>
                            <input type="date" id="tanggal" value={hariIni} class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none bg-slate-50 focus:bg-white transition" required />
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Nominal (Rp) <span class="text-red-500">*</span></label>
                            <input type="number" id="nominal" min="1" placeholder="Contoh: 50000" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none bg-slate-50 focus:bg-white transition" required />
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Keterangan / Beli Apa? <span class="text-red-500">*</span></label>
                        <input type="text" id="keterangan" placeholder="Contoh: Beli 2 Galon Aqua" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none bg-slate-50 focus:bg-white transition" required />
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Sumber Dana <span class="text-red-500">*</span></label>
                        <select id="sumberDana" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none bg-slate-50 focus:bg-white transition" required>
                            <option value="laci_kasir" selected>Laci Kasir (Cash Fisik)</option>
                            <option value="transfer_bank">Transfer Bank / M-Banking</option>
                        </select>
                    </div>

                    <div class="pt-2 flex justify-end">
                        <button type="submit" id="btnSimpanOperasional" class="w-full md:w-auto bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3.5 rounded-xl font-bold shadow-sm transition inline-flex items-center justify-center gap-2">
                            <i class="fa-solid fa-save"></i> Simpan Operasional
                        </button>
                    </div>
                </form>
            </div>

            <!-- KARTU 2: PENGATURAN BENGKEL -->
            <div class="bg-white rounded-3xl shadow-sm border border-slate-200 p-8 h-fit">
                <div class="mb-6 border-b border-slate-100 pb-4">
                    <h2 class="text-xl font-bold text-slate-800"><i class="fa-solid fa-gear text-slate-500 mr-2"></i> Pengaturan Bengkel</h2>
                    <p class="text-sm text-slate-500 mt-1">Atur nilai patokan untuk potongan biaya tetap dan jatah makan.</p>
                </div>

                <form id="formPengaturan" class="space-y-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Biaya Tetap Harian (Rp) <span class="text-red-500">*</span></label>
                        <p class="text-xs text-slate-500 mb-2">Penyusutan sewa tempat, listrik, dll per hari.</p>
                        <input type="number" id="biayaTetap" min="0" placeholder="Loading..." class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none bg-slate-50 focus:bg-white transition" required />
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Uang Makan Per Hari (Rp) <span class="text-red-500">*</span></label>
                        <p class="text-xs text-slate-500 mb-2">Standar uang makan untuk mekanik saat absensi.</p>
                        <input type="number" id="uangMakan" min="0" placeholder="Loading..." class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none bg-slate-50 focus:bg-white transition" required />
                    </div>

                    <div class="pt-2 flex justify-end">
                        <button type="submit" id="btnSimpanPengaturan" class="w-full md:w-auto bg-slate-800 hover:bg-slate-900 text-white px-8 py-3.5 rounded-xl font-bold shadow-sm transition inline-flex items-center justify-center gap-2">
                            <i class="fa-solid fa-check-double"></i> Update Pengaturan
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</Layout>

<script is:inline>
    // --- 1. LOGIK LOAD DATA PENGATURAN BENGKEL SAAT HALAMAN DIBUKA ---
    document.addEventListener("DOMContentLoaded", async () => {
        try {
            // Diubah mengarah ke API internal Astro (/api/pengaturan-bengkel)
            const res = await fetch('/api/pengaturan-bengkel');
            const json = await res.json();
            
            if (json.data) {
                document.getElementById('biayaTetap').value = json.data.biaya_tetap_harian || 0;
                document.getElementById('uangMakan').value = json.data.uang_makan_per_hari || 0;
            }
        } catch (error) {
            console.error("Gagal memuat pengaturan bengkel:", error);
        }
    });

    // --- 2. LOGIK SIMPAN PENGELUARAN OPERASIONAL ---
    // (TIDAK ADA PERUBAHAN SAMA SEKALI)
    document.getElementById('formOperasional').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('btnSimpanOperasional');
        const originalText = btn.innerHTML;
        btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...`;
        btn.disabled = true;

        try {
            const response = await fetch('/api/tambah-pengeluaran', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    tanggal_pengeluaran: document.getElementById('tanggal').value,
                    keterangan: document.getElementById('keterangan').value,
                    nominal: document.getElementById('nominal').value,
                    sumber_dana: document.getElementById('sumberDana').value,
                    kategori: "operasional"
                })
            });

            const result = await response.json();
            if (result.success) {
                alert("Pengeluaran operasional berhasil dicatat!");
                window.location.href = "/pengeluaran";
            } else {
                alert("Gagal: " + (result.message || "Kesalahan server"));
            }
        } catch (error) {
            alert("Terjadi kesalahan jaringan.");
            console.error(error);
        } finally {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    });

    // --- 3. LOGIK UPDATE PENGATURAN BENGKEL ---
    document.getElementById('formPengaturan').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('btnSimpanPengaturan');
        const originalText = btn.innerHTML;
        btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Updating...`;
        btn.disabled = true;

        try {
            // Diubah mengarah ke API internal Astro (/api/pengaturan-bengkel)
            const response = await fetch('/api/pengaturan-bengkel', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    biaya_tetap_harian: document.getElementById('biayaTetap').value,
                    uang_makan_per_hari: document.getElementById('uangMakan').value
                })
            });

            if (response.ok) {
                alert("Pengaturan Bengkel berhasil diperbarui!");
            } else {
                alert("Gagal mengupdate pengaturan.");
            }
        } catch (error) {
            alert("Terjadi kesalahan jaringan saat update pengaturan.");
            console.error(error);
        } finally {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    });
</script>