---
// src/pages/penggajian/mekanik.astro
import Layout from "../../layouts/Layout.astro";
import { postWithAuth } from "../../lib/api";

const token = Astro.cookies.get("directus_token")?.value;

let errorMessage = "";

// Proses Form Submit (Server-Side)
if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        const nama_mekanik = data.get("nama_mekanik");
        const nomor_telepon = data.get("nomor_telepon");

        // Kirim data ke Directus menggunakan postWithAuth
        await postWithAuth("/items/mekanik", {
            nama_mekanik: nama_mekanik,
            nomor_telepon: nomor_telepon
        }, token);
        
        // Langsung redirect jika sukses
        return Astro.redirect("/penggajian");
    } catch (error) {
        console.error("Gagal menyimpan mekanik:", error.response?.data || error.message);
        errorMessage = error.response?.data?.errors?.[0]?.message || "Terjadi kesalahan saat menyimpan data.";
    }
}
---

<Layout title="Tambah Data Mekanik">
    <div class="max-w-3xl mx-auto px-4 py-8">
        
        {/* Header Section */}
        <div class="flex items-center gap-4 mb-8">
            <a href="/penggajian" class="w-10 h-10 flex justify-center items-center rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 transition">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="text-3xl font-black text-slate-800 tracking-tight">Tambah Mekanik Baru</h1>
                <p class="text-slate-500 mt-1">Daftarkan mekanik baru ke dalam database bengkel.</p>
            </div>
        </div>

        {/* Alert Error */}
        {errorMessage && (
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-6 flex items-center gap-2">
                <i class="fa-solid fa-triangle-exclamation"></i> {errorMessage}
            </div>
        )}

        {/* Card Form */}
        <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="bg-indigo-50 border-b border-indigo-100 p-6">
                <h2 class="text-lg font-black text-indigo-900">Formulir Data Mekanik</h2>
            </div>
            
            <form method="POST" class="p-6">
                <div class="space-y-6">
                    
                    {/* Input Nama Mekanik */}
                    <div>
                        <label for="nama_mekanik" class="block text-sm font-bold text-slate-700 mb-2">Nama Mekanik <span class="text-red-500">*</span></label>
                        <input 
                            type="text" 
                            id="nama_mekanik" 
                            name="nama_mekanik" 
                            placeholder="Contoh: Budi Santoso"
                            required
                            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-slate-800 bg-slate-50 focus:bg-white"
                        />
                    </div>

                    {/* Input Nomor Telepon */}
                    <div>
                        <label for="nomor_telepon" class="block text-sm font-bold text-slate-700 mb-2">Nomor Telepon</label>
                        <input 
                            type="tel" 
                            id="nomor_telepon" 
                            name="nomor_telepon" 
                            placeholder="Contoh: 081234567890"
                            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-slate-800 bg-slate-50 focus:bg-white"
                        />
                        <p class="text-xs text-slate-400 mt-1">Boleh dikosongkan jika belum memiliki nomor telepon.</p>
                    </div>

                </div>

                <div class="mt-8 flex justify-end gap-3">
                    <a href="/penggajian" class="px-6 py-3 rounded-xl font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 transition">
                        Batal
                    </a>
                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-xl font-black shadow-lg shadow-indigo-200 transition flex items-center gap-2">
                        <i class="fa-solid fa-floppy-disk"></i> Simpan Data
                    </button>
                </div>
            </form>
        </div>

    </div>
</Layout>