                        >
                    </div>
                    <div class="overflow-x-auto flex-1">
                        <table class="w-full text-left text-sm">
                            <thead
                                class="bg-white border-b border-slate-100 text-[10px] uppercase tracking-wider text-slate-400 font-black"
                            >
                                <tr>
                                    <th class="p-4">ID Nota</th>
                                    <th class="p-4">Waktu (WIB)</th>
                                    <th class="p-4">Total Tagihan</th>
                                    <th class="p-4 text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50">
                                {
                                    transaksiTerbaru.length === 0 ? (
                                        <tr>
                                            <td
                                                colspan="4"
                                                class="p-8 text-center text-slate-400 text-sm"
                                            >
                                                Belum ada transaksi di rentang
                                                tanggal ini.
                                            </td>
                                        </tr>
                                    ) : (
                                        transaksiTerbaru.map((trx) => (
                                            <tr class="hover:bg-slate-50 transition">
                                                <td class="p-4 font-bold text-slate-700">
                                                    #{trx.id}
                                                </td>
                                                <td class="p-4 text-xs text-slate-500">
                                                    {formatTanggalWIB(
                                                        trx.tanggal_transaksi,
                                                    )}
                                                </td>
                                                <td class="p-4 font-medium text-slate-600">
                                                    {formatRp(
                                                        trx.total_harga || 0,
                                                    )}
                                                </td>
                                                <td class="p-4 text-center">
                                                    {trx.status_nota ===
                                                    "lunas" ? (
                                                        <span class="bg-emerald-50 text-emerald-600 px-2 py-1 rounded text-[10px] font-bold border border-emerald-100 uppercase">
                                                            Lunas
                                                        </span>
                                                    ) : (
                                                        <span class="bg-amber-50 text-amber-600 px-2 py-1 rounded text-[10px] font-bold border border-amber-100 uppercase">
                                                            Proses
                                                        </span>
                                                    )}
