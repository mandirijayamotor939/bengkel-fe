                                            </tr>
                                        ))
                                    )
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div
                class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col"
            >
                <div
                    class="p-5 border-b border-slate-100 bg-slate-50/50 flex items-center gap-2"
                >
                    <i class="fa-solid fa-fire text-orange-500"></i>
                    <h3 class="font-bold text-slate-800 text-sm">
                        Top 10 Produk Terlaris
                    </h3>
                </div>
                <div class="p-2 flex-1 overflow-y-auto max-h-[300px]">
                    {
                        topProduk.length === 0 ? (
                            <div class="text-center text-slate-400 py-10">
                                <>
                                    <i class="fa-solid fa-box-open text-3xl mb-2 opacity-30" />
                                    <p class="text-xs font-medium">
                                        Belum ada barang terjual.
                                    </p>
                                </>
                            </div>
                        ) : (
                            <ul class="divide-y divide-slate-50">
                                {topProduk.map((prod, index) => (
                                    <li class="p-3 hover:bg-slate-50 flex justify-between items-center transition rounded-lg">
                                        <div class="flex items-center gap-3">
                                            <span
                                                class={`w-6 h-6 flex items-center justify-center rounded text-[10px] font-bold ${index < 3 ? "bg-orange-100 text-orange-600" : "bg-slate-100 text-slate-500"}`}
                                            >
                                                {index + 1}
                                            </span>
                                            <span class="text-sm font-bold text-slate-700">
                                                {prod.name}
                                            </span>
                                        </div>
                                        <div class="text-xs font-bold text-slate-500 bg-slate-100 px-2 py-1 rounded-md">
