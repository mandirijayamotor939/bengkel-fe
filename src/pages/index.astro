        <!-- TRANSAKSI TERAKHIR & PRODUK TERLARIS -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2">
                <div
                    class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden h-full flex flex-col"
                >
                    <div
                        class="p-5 border-b border-slate-100 flex justify-between items-center bg-slate-50/50"
                    >
                        <h3
                            class="font-bold text-slate-800 flex items-center gap-2 text-sm"
                        >
                            <i class="fa-solid fa-receipt text-indigo-500"></i> 5
                            Transaksi Terakhir
                        </h3>
                        <a
                            href="/transaksi"
