    <!-- MODAL SETORAN (POP-UP INPUT NOMINAL) -->
    <div
        id="setorModal"
        class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center px-4"
    >
        <div
            class="bg-white p-8 rounded-2xl shadow-2xl max-w-md w-full relative animate-fade-in-up"
        >
            <button
                onclick="document.getElementById('setorModal').classList.add('hidden')"
                class="absolute top-4 right-4 text-slate-400 hover:text-slate-600"
            >
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <div
                class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mb-5 text-2xl border-4 border-white shadow-sm"
            >
                <i class="fa-solid fa-money-bill-transfer"></i>
            </div>
            <h2 class="text-xl font-black text-slate-800 mb-1 tracking-tight">
                Setor Uang Fisik ke Bank
            </h2>
            <p class="text-slate-500 mb-6 text-sm leading-relaxed">
                Estimasi uang di laci: <strong
                    >{formatRp(estimasiUangLaci)}</strong
                >.
            </p>

            <form id="formSetoran" class="flex flex-col gap-4">
                <input type="hidden" id="tanggalSetor" value={todayStr} />
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1"
                        >Nominal Disetor (Rp)</label
                    >
                    <input
                        type="number"
                        id="nominalSetor"
                        required
                        class="w-full bg-slate-50 border border-slate-200 px-4 py-2.5 rounded-xl text-sm font-bold text-slate-800 outline-none focus:border-emerald-500 transition"
                        placeholder="Contoh: 500000"
                    />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1"
                        >Keterangan</label
                    >
                    <input
                        type="text"
                        id="keteranganSetor"
                        class="w-full bg-slate-50 border border-slate-200 px-4 py-2.5 rounded-xl text-sm font-medium text-slate-800 outline-none focus:border-emerald-500 transition"
                        placeholder="Setoran kasir siang..."
                    />
                </div>
                <button
                    type="submit"
                    id="btnSubmitSetor"
                    class="mt-2 w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-4 rounded-xl transition shadow-lg shadow-emerald-200 flex justify-center items-center gap-2"
                >
                    <span>Proses Setoran Sekarang</span>
                </button>
            </form>
        </div>
    </div>

    <!-- SCRIPT EXPORT EXCEL -->
    <script
        src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"
        is:inline></script>
    <script is:inline define:vars={{ startDate, endDate }}>
        document
            .getElementById("btnExport")
            .addEventListener("click", async () => {
                const btn = document.getElementById("btnExport");
                const originalText = btn.innerHTML;

                // Ubah tombol jadi loading
                btn.innerHTML =
                    '<i class="fa-solid fa-spinner animate-spin"></i> Menyiapkan...';
                btn.disabled = true;

                try {
                    // Tarik data dari API yang baru kita buat
                    const response = await fetch(
                        `/api/export-dashboard?start=${startDate}&end=${endDate}`,
                    );
                    const result = await response.json();

                    if (result.success) {
                        // Rakit ke Excel menggunakan data dari API
                        const worksheet = XLSX.utils.json_to_sheet(result.data);
                        const workbook = XLSX.utils.book_new();
                        XLSX.utils.book_append_sheet(
                            workbook,
                            worksheet,
                            "Laporan Keuangan",
                        );

                        // Lebarkan kolom agar rapi
                        worksheet["!cols"] = [{ wch: 45 }, { wch: 20 }];

                        let fileName = `Laporan_Bengkel_${startDate}.xlsx`;
                        if (startDate !== endDate) {
                            fileName = `Laporan_Bengkel_${startDate}_sd_${endDate}.xlsx`;
                        }

                        XLSX.writeFile(workbook, fileName);
                    } else {
                        alert(
                            "Gagal menarik data untuk Excel: " + result.message,
                        );
                    }
                } catch (error) {
                    console.error(error);
                    alert("Terjadi kesalahan jaringan saat mengekspor Excel.");
                } finally {
                    // Kembalikan kondisi tombol
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            });
    </script>
    <!-- SCRIPT AJAX UNTUK MENGIRIM SETORAN KE BACKEND API -->
    <script is:inline>
        document
            .getElementById("formSetoran")
            ?.addEventListener("submit", async (e) => {
                e.preventDefault();
                const btn = document.getElementById("btnSubmitSetor");
                const nominal = document.getElementById("nominalSetor").value;
                const keterangan =
                    document.getElementById("keteranganSetor").value;
                const tanggal_input =
                    document.getElementById("tanggalSetor").value;

                btn.disabled = true;
                btn.innerHTML =
                    '<i class="fa-solid fa-spinner animate-spin"></i> Memproses...';

                try {
                    const res = await fetch("/api/tambah-setoran", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            nominal,
                            keterangan,
                            tanggal_input,
                        }),
                    });

                    const data = await res.json();
                    if (data.success) {
                        alert(data.message);
                        window.location.reload();
                    } else {
                        alert("Gagal: " + data.message);
                        btn.disabled = false;
                        btn.innerHTML = "Proses Setoran Sekarang";
                    }
                } catch (err) {
                    alert("Terjadi kesalahan sistem.");
                    btn.disabled = false;
                    btn.innerHTML = "Proses Setoran Sekarang";
                }
            });
    </script>

    <style>
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px) scale(0.95);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        .animate-fade-in-up {
            animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</Layout>
